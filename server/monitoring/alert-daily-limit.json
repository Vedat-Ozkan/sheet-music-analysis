{
  "displayName": "Daily limit reached",
  "documentation": {"content": "A user was turned away because the daily limit (drafts, renders or PDF pages, shared by everyone) was reached. It resets at midnight UTC. The limits are DAILY_LIMITS in server/app.py.", "mimeType": "text/markdown"},
  "combiner": "OR",
  "conditions": [{
    "displayName": "a call hit the daily limit",
    "conditionThreshold": {
      "filter": "metric.type=\"logging.googleapis.com/user/tool_calls\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"sheet-music-analysis\" AND metric.label.outcome=\"limit\"",
      "aggregations": [{"alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["resource.label.service_name"]}],
      "comparison": "COMPARISON_GT",
      "thresholdValue": 0,
      "duration": "0s",
      "trigger": {"count": 1}
    }
  }],
  "alertStrategy": {"autoClose": "86400s"}
}
