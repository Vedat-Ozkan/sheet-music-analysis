{
  "displayName": "Cost guard: billable instance time",
  "documentation": {"content": "Production billed more than an hour of instance time in a day. Normal use is a few minutes; engineering log 21 found 15,450 s/day from held-open streams.", "mimeType": "text/markdown"},
  "combiner": "OR",
  "conditions": [{
    "displayName": "billable instance time over 3600 s in a day",
    "conditionThreshold": {
      "filter": "metric.type=\"run.googleapis.com/container/billable_instance_time\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"sheet-music-analysis\"",
      "aggregations": [{"alignmentPeriod": "86400s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["resource.label.service_name"]}],
      "comparison": "COMPARISON_GT",
      "thresholdValue": 3600,
      "duration": "0s",
      "trigger": {"count": 1}
    }
  }],
  "alertStrategy": {"autoClose": "86400s"}
}
