+    private static byte[] sweep (byte[] source,
+                                 int imageWidth,
+                                 int imageHeight,
+                                 int[][] rows,
+                                 boolean dilate)
+    {
+        final int neutral = dilate ? 0 : 255;
+        final java.util.Map<Long, byte[]> horizontals = new java.util.HashMap<>();
+        final byte[][] perRow = new byte[rows.length][];
+
+        for (int r = 0; r < rows.length; r++) {
