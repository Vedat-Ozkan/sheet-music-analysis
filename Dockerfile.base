# Everything slow to install: Python, the engine's packages and Audiveris.
# Rebuilt by server/deploy.sh only when this file or the package lists change; Dockerfile adds the code on top.
FROM python:3.11-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

# The engine and server.
COPY pyproject.toml uv.lock ./
# Only the package lists are here, so the project itself is not installed; Dockerfile copies the code.
RUN uv sync --frozen --no-default-groups --group server --no-install-project

# Audiveris reads PDFs (engine/read_pdf.py). Its .deb carries its own Java runtime and is unpacked rather than
# installed: the X, GTK and sound libraries it declares are for its window, and batch mode runs without them.
RUN curl -fL -o /tmp/audiveris.deb https://github.com/Audiveris/audiveris/releases/download/5.11.0/Audiveris-5.11.0-ubuntu24.04-x86_64.deb \
 && echo "f20113aaa33b3149ec8d6a09b2a7963360e65fafd92d69389987a85bbc3ec7a3  /tmp/audiveris.deb" | sha256sum -c \
 && dpkg-deb -x /tmp/audiveris.deb /audiveris && rm /tmp/audiveris.deb
# Our fixes to it (tuplets sharing a beam, crashes that lost pages and bars; log 35), built from
# https://github.com/Vedat-Ozkan/audiveris branch sma-pitch as its licence (AGPL-3.0) requires.
RUN curl -fL -o /audiveris/opt/audiveris/lib/app/audiveris.jar https://github.com/Vedat-Ozkan/audiveris/releases/download/5.11.0-sma.8/audiveris.jar \
 && echo "a4f49dd5e80fcceda4eb1f1064d310e585d4529366090e576b1f736e04d70951  /audiveris/opt/audiveris/lib/app/audiveris.jar" | sha256sum -c

RUN mkdir /audiveris/opt/audiveris/tessdata \
 && curl -fL -o /audiveris/opt/audiveris/tessdata/eng.traineddata https://github.com/tesseract-ocr/tessdata/raw/ced78752cc61322fb554c280d13360b35b8684e4/eng.traineddata \
 && echo "daa0c97d651c19fba3b25e81317cd697e9908c8208090c94c3905381c23fc047  /audiveris/opt/audiveris/tessdata/eng.traineddata" | sha256sum -c

FROM python:3.11-slim
# cairo draws the vector PDF (cairosvg); it brings fontconfig, which reads engine/fonts/fonts.conf.
RUN apt-get update && apt-get install -y --no-install-recommends libcairo2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/.venv .venv
COPY --from=build /audiveris/opt/audiveris /opt/audiveris
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
